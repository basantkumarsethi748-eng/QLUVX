# AGORA_APP_ID: Required 32-character hex Agora App ID from console.agora.io
AGORA_APP_ID=YOUR_AGORA_APP_ID

# AGORA_TEMP_TOKEN: Optional Agora RTC temporary token from console.agora.io (must match channel name and UID=0)
AGORA_TEMP_TOKEN=YOUR_AGORA_TEMP_TOKEN

# AGORA_DEFAULT_CHANNEL: Default Agora channel name matching your AGORA_TEMP_TOKEN
AGORA_DEFAULT_CHANNEL=qluvx_live

# AGORA_TOKEN_SERVER_URL: Optional backend endpoint to fetch RTC tokens dynamically in production (never store App Certificate in client code)
AGORA_TOKEN_SERVER_URL=YOUR_AGORA_TOKEN_SERVER_URL

# QLUVX_BACKEND_API_URL: Optional backend endpoint for server-validated wallet coins, gifts, permissions, and multiplayer game state
QLUVX_BACKEND_API_URL=YOUR_QLUVX_BACKEND_API_URL
