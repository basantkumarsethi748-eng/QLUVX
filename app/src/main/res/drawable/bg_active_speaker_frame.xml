<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glowing halo ring for active speaker -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#2600D2FF" />
            <stroke
                android:width="2dp"
                android:color="#8000D2FF" />
        </shape>
    </item>
    <!-- Inner vibrant active speaker ring -->
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="#1A00E676" />
            <stroke
                android:width="2.5dp"
                android:color="#FF00E5FF" />
        </shape>
    </item>
</layer-list>
