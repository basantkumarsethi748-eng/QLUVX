<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090E"
    android:padding="26dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_seat_neon_gold"
            android:gravity="center"
            android:text="👑"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="QLUVX"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp"
            android:text="Nearby Discovery • Live PK • Spatial Audio"
            android:textColor="#8E8E93"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_walla_glass_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.06"
                android:text="MOBILE NUMBER"
                android:textColor="#8E8E93"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_walla_pill_dark"
                android:hint="+91 98765 43210"
                android:inputType="phone"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8E93"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etOtp"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_walla_pill_dark"
                android:hint="Enter 4-Digit OTP (e.g. 1234)"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8E93"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSendOtp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_walla_pink_pill"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Continue"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="18dp"
            android:letterSpacing="0.06"
            android:text="OR SIGN IN WITH"
            android:textColor="#8E8E93"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGoogleLogin"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_walla_glass_card"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Continue with Google"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnQuickGuest"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_walla_gold_pill"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="👑 Quick VIP Access (Julian Vance)"
            android:textAllCaps="false"
            android:textColor="#E6B800"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>
