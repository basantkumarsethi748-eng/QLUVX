<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A14"
    android:padding="26dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_seat_neon_gold"
            android:gravity="center"
            android:text="👑"
            android:textSize="36sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.12"
            android:text="WALLA • QLUVX"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp"
            android:text="Nearby Guys • HD Live PK • 8-Seat Voice Party"
            android:textColor="#00E5FF"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_walla_glass_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="MOBILE NUMBER"
                android:textColor="#F1C40F"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_walla_pill_dark"
                android:hint="+91 98765 43210"
                android:inputType="phone"
                android:paddingHorizontal="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#7A7A9A"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etOtp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_walla_pill_dark"
                android:hint="Enter 4-Digit OTP (e.g. 1234)"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:paddingHorizontal="16dp"
                android:textColor="#F1C40F"
                android:textColorHint="#7A7A9A"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSendOtp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#FF2A7A"
                android:text="Get Verification Code"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="18dp"
            android:text="— OR INSTANT LOGIN —"
            android:textColor="#7E7E9C"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGoogleLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#141424"
            android:text="🌐  Continue with Google"
            android:textAllCaps="false"
            android:textColor="#00E5FF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnQuickGuest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#F1C40F"
            android:text="⚡  Quick VIP Login (Julian Vance)"
            android:textAllCaps="false"
            android:textColor="#0A0A14"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>
