<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_outer_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120">

    <!-- Full-Screen Dynamic App Wallpaper (bg_channel_0..bg_channel_list) -->
    <ImageView
        android:id="@+id/iv_main_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.42"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_channel_0" />

    <!-- Subtle Glass Scrim so cards & typography pop cleanly over any wallpaper -->
    <View
        android:id="@+id/view_main_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C0B1120" />

    <LinearLayout
        android:id="@+id/main_root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. Sleek Top Brand, Theme/Wallpaper Studio, Wallet & Create Room Header -->
        <LinearLayout
            android:id="@+id/top_app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E6151F32"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_brand_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.03"
                        android:text="@string/app_name"
                        android:textColor="#F8FAFC"
                        android:textSize="19.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_brand_live_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_card_elevated"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="2dp"
                        android:text="LIVE HUB"
                        android:textColor="#38BDF8"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_brand_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/app_tagline"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_top_vip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_top_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_top_notifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_top_theme_wallpaper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_elevated"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="🎨 Theme"
                android:textColor="#F472B6"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_top_wallet_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_card_elevated"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="🪙 2,500"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_top_create_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_primary"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:text="+ Room"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Clean 12-Menu Horizontal Navigation Strip -->
        <HorizontalScrollView
            android:id="@+id/top_menu_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E6160D2B"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/menu_tabs_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <View
            android:id="@+id/top_divider_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#8B5CF6" />

        <!-- 3. Scrollable Main Content Viewport -->
        <ScrollView
            android:id="@+id/main_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/main_menu_content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="18dp" />
        </ScrollView>

        <View
            android:id="@+id/bottom_divider_line"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#228B5CF6"
            android:visibility="gone" />

        <!-- 4. Floating Pill 5-Tab Bottom Navigation Dock: 1. Home | 2. Discover | 3. Chat | 4. Live | 5. Me -->
        <LinearLayout
            android:id="@+id/bottom_quick_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:background="#F21C1E26"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:weightSum="5">

            <TextView
                android:id="@+id/nav_bottom_home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="46dp"
                android:text="🏠\nHome"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nav_bottom_discover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="46dp"
                android:text="👁️ 2\nDiscover"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nav_bottom_chat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="46dp"
                android:text="💬 99+\nChat"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nav_bottom_voice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="46dp"
                android:text="📹\nLive"
                android:textColor="#0F172A"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nav_bottom_profile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="46dp"
                android:text="👤 •\nMe"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
