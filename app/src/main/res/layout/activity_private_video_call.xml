<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootPrivateVideoCall"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090E">

    <!-- 1. FULL-SCREEN REMOTE PARTNER HD VIDEO SURFACE + PORTRAIT BACKDROP -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivRemotePartnerBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <VideoView
            android:id="@+id/vvRemotePartnerVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true" />

        <!-- Subtle Top & Bottom Gradient Scrims for Readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_nearby_bottom_scrim" />
    </RelativeLayout>

    <!-- 2. TOP CALL HEADER: Partner Info, Encrypted HD Badge & Real-Time Call Timer -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="14dp"
        android:paddingTop="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_walla_pill_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <androidx.cardview.widget.CardView
                android:layout_width="38dp"
                android:layout_height="38dp"
                app:cardBackgroundColor="#13131D"
                app:cardCornerRadius="19dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivPartnerHeaderAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCallPartnerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alex Royal, 25 ✓"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCallEncryptedStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 1-on-1 Private HD • E2EE Secured"
                    android:textColor="#30D158"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Real-Time Ticking Call Timer Pill -->
        <TextView
            android:id="@+id/tvCallTimer"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_walla_pink_pill"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="🔴 00:01"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 3. FLOATING PICTURE-IN-PICTURE (PiP) LOCAL CAMERA PREVIEW CARD (Draggable & Tap-to-Flip) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardFloatingPipLocal"
        android:layout_width="118dp"
        android:layout_height="168dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="14dp"
        app:cardBackgroundColor="#13131D"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivLocalPipFallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <androidx.camera.view.PreviewView
                android:id="@+id/previewLocalPipCamera"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tvPipCameraBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_walla_pill_dark"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="📹 You (Front)"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- 4. GIFT COMBO STREAK & FLYING GOLD COINS OVERLAY CONTAINER -->
    <FrameLayout
        android:id="@+id/videoCallComboContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- 5. BOTTOM HARDWARE & CALL CONTROL DOCK (Mic Mute, Camera Flip, Gift Combo Streak, End Call) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_walla_glass_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvComboHintBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="💡 Rapid-tap '🔥 Gift Combo' for COMBO STREAK x10! + Flying Gold Coins!"
            android:textColor="#E6B800"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- Mic Mute Toggle -->
            <Button
                android:id="@+id/btnCallMuteMic"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_walla_glass_card"
                android:text="🎙️ Mic ON"
                android:textAllCaps="false"
                android:textColor="#30D158"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Camera Flip Button -->
            <Button
                android:id="@+id/btnCallFlipCamera"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_walla_glass_card"
                android:text="🔄 Flip Cam"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Rapid-Tap Gift Combo Streak Button -->
            <Button
                android:id="@+id/btnCallGiftCombo"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_walla_gold_pill"
                android:text="🔥 Gift Combo"
                android:textAllCaps="false"
                android:textColor="#E6B800"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <!-- End Call Button -->
            <Button
                android:id="@+id/btnEndVideoCall"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="0.85"
                android:background="@drawable/bg_walla_pink_pill"
                android:text="📞 End"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
