<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A14"
    android:padding="16dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_walla_glass_card"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="⬅ Back"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Profile &amp; Privacy Settings"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 1. Edit Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_walla_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISPLAY NICKNAME"
                android:textColor="#F1C40F"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNickname"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_walla_pill_dark"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:text="Julian Vance"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="ABOUT ME / BIO"
                android:textColor="#F1C40F"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etBio"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_walla_pill_dark"
                android:gravity="top"
                android:padding="12dp"
                android:text="Fitness, rooftop lounges &amp; late night voice party host 👑✨"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!-- Dating Role Selector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="WALLA DATING ROLE TAG"
                android:textColor="#FF2A7A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbTop"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Top"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbVersatile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Versatile"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rbBottom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bottom"
                    android:textColor="#FFFFFF" />
            </RadioGroup>

            <!-- Height & Weight Sliders -->
            <TextView
                android:id="@+id/tvHeightVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Height: 180 cm"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="60"
                android:progress="30" />

            <TextView
                android:id="@+id/tvWeightVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Weight: 75 kg"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="75"
                android:progress="30" />
        </LinearLayout>

        <!-- 2. Stealth Mode & Privacy Switches -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_walla_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="🕵️ VIP STEALTH &amp; PRIVACY CONTROLS"
                android:textColor="#F1C40F"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swGhostMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🕵️ Stealth Mode (Invisible Browsing &amp; Status)"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp" />

            <Switch
                android:id="@+id/swHideDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="📍 Hide My Exact Distance on Nearby Grid"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp" />

            <Button
                android:id="@+id/btnOpenPrivacyCloakFromSettings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_walla_gold_pill"
                android:text="🛡️ Privacy Cloak, Calculator Disguise 🧮 &amp; Panic Exit 🚨"
                android:textAllCaps="false"
                android:textColor="#0A0A14"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOpenTeleportFromSettings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_walla_cyan_pill"
                android:text="🌍 Global City Radar Teleport (Bangkok, Tokyo, NY...)"
                android:textAllCaps="false"
                android:textColor="#0A0A14"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Save Profile Button -->
        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#00E5FF"
            android:text="💾  Save Profile &amp; Privacy Settings"
            android:textAllCaps="false"
            android:textColor="#0A0A14"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- LOGOUT BUTTON WITH CONFIRMATION DIALOG -->
        <Button
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="28dp"
            android:backgroundTint="#28101C"
            android:text="🚪 Log Out of QLUVX"
            android:textAllCaps="false"
            android:textColor="#FF2A7A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:strokeColor="#FF2A7A" />

    </LinearLayout>
</ScrollView>
