<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootTeleportContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A14">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 1. TOP HEADER BAR -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <TextView
                    android:id="@+id/btnBackTeleport"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_walla_glass_card"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="⬅ Back"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌍 GLOBAL RADAR TELEPORT"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Roam 6 World Pride Capitals Instantly"
                        android:textColor="#F1C40F"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnResetLocalGps"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_walla_pink_pill"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="📍 Local GPS"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- 2. ANIMATED SATELLITE RADAR SCANNER STAGE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_walla_glass_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/radarCanvasFrame"
                    android:layout_width="176dp"
                    android:layout_height="176dp" />

                <TextView
                    android:id="@+id/tvActiveTeleportStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_walla_cyan_pill"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="4dp"
                    android:text="📡 ACTIVE GPS: 🇮🇳 Bangalore • 12.9716° N, 77.5946° E"
                    android:textColor="#0A0A14"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRadarSubtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Tap any global city card below to teleport your GPS coordinates &amp; load that city's nearby guys immediately!"
                    android:textColor="#C7C7E2"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 3. WORLD CITY ROAMING GRID HEADER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:text="✈️ SELECT DESTINATION CITY (1-TAP GPS TELEPORT)"
                android:textColor="#F1C40F"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Dynamic 2-Column Global Roaming Grid Container (Bangkok, Tokyo, London, Paris, Mumbai, New York) -->
            <LinearLayout
                android:id="@+id/llWorldCitiesGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
