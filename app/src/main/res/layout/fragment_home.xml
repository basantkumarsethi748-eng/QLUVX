<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A18"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#121228"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="🔥 Nearby Guys"
            android:textColor="#FFD700"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFilter"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="#252545"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="⚡ Online • Role ▾"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Search Bar -->
    <EditText
        android:id="@+id/etSearchNearby"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_margin="10dp"
        android:background="#181832"
        android:hint="🔍 Search by nickname, role (Top/Bottom), or city..."
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#777799"
        android:textSize="13sp" />

    <!-- 3-Column Nearby Users Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNearbyGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="4dp" />

</LinearLayout>
