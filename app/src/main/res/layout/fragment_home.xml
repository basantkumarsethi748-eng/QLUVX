<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090E"
    android:orientation="vertical">

    <!-- 1. 2026 LUXURY MINIMALIST TOP BAR: "Nearby" Title, Sleek Search Icon, Translucent Filter Pill -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#09090E"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNearbyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="Nearby"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Minimalist Location Selector Capsule -->
            <TextView
                android:id="@+id/tvLocationSelector"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_walla_pill_dark"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Bangalore ▾"
                android:textColor="#8E8E93"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Subtle Global Roaming Pill -->
            <TextView
                android:id="@+id/btnTeleportRadar"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_walla_pill_dark"
                android:gravity="center"
                android:paddingHorizontal="9dp"
                android:text="🌍 Roam"
                android:textColor="#E6B800"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Action Icons: Sleek Search Icon & Translucent Filter Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSearchToggle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_walla_pill_dark"
                android:gravity="center"
                android:text="⌕"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnFilter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_walla_pill_dark"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Filter"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Collapsible Minimalist Search Input -->
    <EditText
        android:id="@+id/etSearchNearby"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_walla_glass_card"
        android:hint="Search name, role, or distance..."
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#8E8E93"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Minimalist Filter Pills Row (Electric Rose Active, Sleek Dark Glass Inactive) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_walla_pink_pill"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="All"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipOnline"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_walla_glass_card"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Online"
                android:textColor="#8E8E93"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipTop"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_walla_glass_card"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Top"
                android:textColor="#8E8E93"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipVersatile"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_walla_glass_card"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Versatile"
                android:textColor="#8E8E93"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipBottom"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_walla_glass_card"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Bottom"
                android:textColor="#8E8E93"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 2. SLEEK LIVE BROADCASTERS STRIP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="6dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="LIVE NOW"
                android:textColor="#8E8E93"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWatchAllLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="See All ›"
                android:textColor="#FF1B6B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llLiveHostsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 3. 2026 EDGE-TO-EDGE 3-COLUMN PORTRAIT DISCOVERY GRID -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNearbyGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="6dp"
        android:paddingBottom="12dp" />

</LinearLayout>
