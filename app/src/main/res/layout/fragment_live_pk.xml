<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pkRootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. FULL-BLEED VERTICAL VIDEO SURFACE FILLING THE ENTIRE SCREEN -->
    <LinearLayout
        android:id="@+id/llVideos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Left Host Full-Bleed Live Camera Surface -->
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#09090E">

            <ImageView
                android:id="@+id/ivHostRedStream"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <androidx.camera.view.PreviewView
                android:id="@+id/previewHostRedCamera"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Subtle Warm Rose Beauty Filter Overlay -->
            <View
                android:id="@+id/viewRedBeautyOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#18FF1B6B" />

            <!-- Bottom Scrim for Host Label & Quick Gift Pill -->
            <View
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/bg_nearby_bottom_scrim" />

            <TextView
                android:id="@+id/tvLeftCameraBadge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="94dp"
                android:background="@drawable/bg_live_comment_pill"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="LIVE CAM"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Minimalist Quick Boost Pill for Left Host -->
            <Button
                android:id="@+id/btnGiftRed"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="10dp"
                android:layout_marginTop="120dp"
                android:background="@drawable/bg_walla_pink_pill"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:text="🌹 Boost Alex +500"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Hairline 1dp Center Split Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#26FFFFFF" />

        <!-- Right Host Full-Bleed Looping HD Video Surface -->
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#09090E">

            <ImageView
                android:id="@+id/ivHostBlueStream"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <VideoView
                android:id="@+id/vvHostBlueStream"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true" />

            <View
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/bg_nearby_bottom_scrim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="94dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_live_comment_pill"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="RYAN • HD"
                android:textColor="#8E8E93"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Minimalist Quick Boost Pill for Right Host -->
            <Button
                android:id="@+id/btnGiftBlue"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="120dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_live_comment_pill"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:text="🏎️ Boost Ryan +500"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

    <!-- 2. MINIMALIST TRANSLUCENT TOP OVERLAY: Broadcaster Frosted Capsule + Top Gifters + Ultra-Thin 4dp PK Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <!-- Broadcaster Pill & Top Gifters Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:paddingHorizontal="12dp">

            <!-- Semi-Transparent Frosted Glass Capsule with Rounded Edges, Small HD Avatar, Follower Count & Clean Pink "+ Follow" Button -->
            <LinearLayout
                android:id="@+id/pillBroadcaster"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_live_comment_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="5dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:cardBackgroundColor="#13131D"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ivBroadcasterAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBroadcasterName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alex Royal ✓"
                        android:textColor="#FFFFFF"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvViewerCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14.2k followers • 1.4k live"
                        android:textColor="#8E8E93"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnFollowHost"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_walla_pink_pill"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="+ Follow"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Top-Right Minimalist Top 3 Gifters Avatars + Sleek Close Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/gifter1Box"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_seat_neon_gold"
                    android:padding="1.5dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/ivGifter1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/gifter2Box"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_seat_neon_cyan"
                    android:padding="1.5dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="13dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/ivGifter2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/gifter3Box"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_seat_neon_cyan"
                    android:padding="1.5dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="13dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/ivGifter3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop" />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <TextView
                    android:id="@+id/btnCloseBroadcast"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_live_comment_pill"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- PK TUG-OF-WAR BAR: Ultra-Thin (4dp) Glowing Metallic Bar with Sleek "VS" Center Badge -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="4dp">

            <!-- Score Readouts Subtle Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top">

                <TextView
                    android:id="@+id/tvScoreRed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="18,450"
                    android:textColor="#FF4585"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPkTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="04:42"
                    android:textColor="#8E8E93"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScoreBlue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="14,900"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Ultra-Thin 4dp Glowing Metallic Bar Track -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/barRedSegment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="55"
                    android:background="@drawable/bg_walla_pink_pill" />

                <View
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:background="#E6B800" />

                <RelativeLayout
                    android:id="@+id/barBlueSegment"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="45"
                    android:background="#48FFFFFF" />
            </LinearLayout>

            <!-- Sleek "VS" Center Metallic Badge -->
            <TextView
                android:layout_width="24dp"
                android:layout_height="15dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/bg_walla_gold_pill"
                android:gravity="center"
                android:text="VS"
                android:textColor="#E6B800"
                android:textSize="8.5sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- 3. MINIMALIST TRANSLUCENT BOTTOM OVERLAY: Floating Rounded Comment Pills (#80000000) + Frosted Glass Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="10dp">

        <!-- Subtle Champagne Gold VIP Entrance Pill -->
        <TextView
            android:id="@+id/tvVipEntranceBanner"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_walla_gold_pill"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:text="👑 Julian Vance entered • VIP Lv.50"
            android:textColor="#E6B800"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Floating Live Chat Stream (Borderless Container holding #80000000 Rounded Pills) + Right Floating Gift & Like -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="136dp">

            <ScrollView
                android:id="@+id/svLiveChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="60dp"
                android:background="@android:color/transparent"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llLiveChatMessages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <!-- Right Floating Minimalist Like & Gift Capsules -->
            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnTapHeart"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_live_comment_pill"
                    android:gravity="center"
                    android:text="♥"
                    android:textColor="#FF1B6B"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/btnOpenGiftTray"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_walla_pink_pill"
                    android:gravity="center"
                    android:text="🎁"
                    android:textSize="18sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Minimalist Translucent Camera/Mic/Studio Pills Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView
                android:id="@+id/btnFlipCameraPk"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_live_comment_pill"
                android:gravity="center"
                android:text="Flip Cam"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnToggleMicPk"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_live_comment_pill"
                android:gravity="center"
                android:text="Mic ON"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnToggleBeautyPk"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_live_comment_pill"
                android:gravity="center"
                android:text="Filter ON"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnOpenBroadcasterStudio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_walla_pink_pill"
                android:gravity="center"
                android:text="Studio"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Minimalist Frosted Comment Input Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etLiveChatInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_live_comment_pill"
                android:hint="Add a comment..."
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8E8E93"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSendLiveChat"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_walla_pink_pill"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="Send"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating Heart Particle & Full-Screen Gift Blast Layer -->
    <FrameLayout
        android:id="@+id/heartParticleContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
