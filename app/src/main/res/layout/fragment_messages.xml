<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A18"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="💬 Messages &amp; Matches"
        android:textColor="#FFD700"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- System Alert Card -->
    <LinearLayout
        android:id="@+id/itemSystemAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="#1A1535"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#2D2258"
            android:gravity="center"
            android:text="🛡️"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QLUVX System Security &amp; VIP Alert"
                android:textColor="#FFD700"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="⚡ Anti-Screenshot Protection Active • 3 New Mutual Matches!"
                android:textColor="#00E676"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chat Item 1 (5-Second Disappearing Photo) -->
    <LinearLayout
        android:id="@+id/itemChat1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="#16162E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#28284E"
            android:gravity="center"
            android:text="🔥"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aarav, 23  •  0.4 km"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDisappearingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="💣 Sent a 5s Disappearing Photo (Tap to View)"
                android:textColor="#FF4081"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chat Item 2 -->
    <LinearLayout
        android:id="@+id/itemChat2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="#16162E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#28284E"
            android:gravity="center"
            android:text="👑"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vikram, 27  •  Online"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="🎙️ Voice Note (0:14) • Hey, join our party room!"
                android:textColor="#A0A0C0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
