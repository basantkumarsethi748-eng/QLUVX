<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090E">

    <!-- 1. DEEP MIDNIGHT AMBIENT STAGE WALLPAPER + SOFT CENTER PURPLE GLOW -->
    <ImageView
        android:id="@+id/ivRoomWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.32"
        android:contentDescription="Voice Room Luxury Wallpaper"
        android:scaleType="centerCrop" />

    <!-- Soft Center Purple Radial Glow on Deep Midnight Ambient Background -->
    <View
        android:layout_width="360dp"
        android:layout_height="360dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_voice_ambient_glow" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <!-- 2. MINIMALIST TOP ROOM HEADER: Room Title, Top 3 Gifters, Theme Pill & Lucky Wheel -->
        <LinearLayout
            android:id="@+id/topHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_walla_glass_card"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRoomTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Midnight Audio Lounge"
                        android:textColor="#FFFFFF"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRoomSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="ID: 99012 • 248 Online • 8-Seat Spatial Audio"
                        android:textColor="#8E8E93"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Minimalist Room Theme Pill -->
                <TextView
                    android:id="@+id/btnWallpaperTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_walla_pill_dark"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Theme"
                    android:textColor="#8E8E93"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Sleek Electric Rose Wheel Pill -->
                <Button
                    android:id="@+id/btnLuckySpin"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_walla_pink_pill"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="🎰 Wheel"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Subtle Top 3 Gifters Strip -->
            <LinearLayout
                android:id="@+id/llTopGiftersStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_walla_pill_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3.5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑 TOP GIFTERS"
                    android:textColor="#E6B800"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTopGiftersLeaderboard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="1. Alex 48.5k  •  2. Ryan 31.2k  •  3. Zayn 19.8k"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. SUBTLE CHAMPAGNE GOLD VIP ENTRANCE CAPSULE -->
        <LinearLayout
            android:id="@+id/cardGoldenEntranceBanner"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_below="@id/topHeader"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_walla_gold_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvGoldenEntranceMarquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="👑 [Lv.50] Julian Vance entered in Interstellar Starship X 🚀"
                android:textColor="#E6B800"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. CENTER HOST THRONE (SEAT 0) WITH SUBTLE GLOWING AUDIO HALO RING -->
        <LinearLayout
            android:id="@+id/hostCenterStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cardGoldenEntranceBanner"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="86dp"
                android:layout_height="86dp">

                <!-- Outer Subtle Champagne Gold Audio Halo -->
                <View
                    android:id="@+id/viewHostPulseOuter"
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_seat_neon_gold" />

                <!-- Inner Subtle Electric Rose Audio Halo -->
                <View
                    android:id="@+id/viewHostPulseInner"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_live_ring_pulse" />

                <!-- Host Circular Avatar -->
                <androidx.cardview.widget.CardView
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="#13131D"
                    app:cardCornerRadius="29dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ivHostSeatAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Host Throne Avatar"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <!-- Delicate Imperial Gold Avatar Frame Overlay -->
                <ImageView
                    android:id="@+id/ivHostDragonFrame"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_gravity="center"
                    android:contentDescription="Host Imperial Gold Frame"
                    android:scaleType="fitCenter" />

                <!-- Top Champagne Gold VIP Host Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_walla_gold_pill"
                    android:gravity="center"
                    android:paddingHorizontal="7dp"
                    android:text="👑 HOST"
                    android:textColor="#E6B800"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <!-- Bottom Live Mic Indicator -->
                <TextView
                    android:id="@+id/tvHostMicBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_walla_pink_pill"
                    android:gravity="center"
                    android:paddingHorizontal="7dp"
                    android:text="ON AIR"
                    android:textColor="#FFFFFF"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvHostSeatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Julian Vance ✓ • Lv.50"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 5. 7 GUEST CIRCULAR SEATS (SEATS 1–7) WITH CLEAN AVATARS & SUBTLE AUDIO HALO RINGS -->
        <LinearLayout
            android:id="@+id/llEightSeatsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/hostCenterStage"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <!-- 6. MINIMALIST DARK GLASS ROOM STREAM LOG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottomVoiceControls"
            android:layout_below="@id/llEightSeatsGrid"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_walla_glass_card"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvSfxLiveTicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spatial Audio Stage • Tap any seat to manage or view profile"
                android:textColor="#8E8E93"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/tvVoiceRoomLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="👑 Julian Vance entered in Interstellar Starship X\nAlex (Seat 1): Dropping progressive house beats tonight\nRyan (Seat 2) sent Supercar x1 to All Mics\nKabir (Seat 3) won +5,000 Coins on Lucky Wheel"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp" />
            </ScrollView>
        </LinearLayout>

        <!-- 7. BOTTOM ACTION BAR: Minimalist Icon Buttons with Frosted Glass Backgrounds -->
        <LinearLayout
            android:id="@+id/bottomVoiceControls"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ivMicToggle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_walla_glass_card"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="🎙️ Mic ON"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ivSoundboard"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_walla_glass_card"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="🔊 SFX"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBottomWheel"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_walla_glass_card"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="🎰 Wheel"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ivGift"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_walla_pink_pill"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="🎁 Gift"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </RelativeLayout>
</FrameLayout>
