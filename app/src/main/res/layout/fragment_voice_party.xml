<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A14">

    <!-- 1. LUXURY ROOM WALLPAPER BACKGROUND (Cyber Galaxy / Royal Gold Palace / Velvet Rose / Midnight Neon) -->
    <ImageView
        android:id="@+id/ivRoomWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Voice Room Luxury Wallpaper"
        android:scaleType="centerCrop" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- 2. TOP ROOM HEADER: Room Title, Top 3 Gifters Leaderboard, 1-Tap Wallpaper Theme Switcher & Lucky Wheel -->
        <LinearLayout
            android:id="@+id/topHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_walla_glass_card"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvRoomTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌌 Cyber Galaxy Voice Club"
                        android:textColor="#F1C40F"
                        android:textSize="14.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRoomSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="ID: 99012 • 🟢 248 Online • 8-Seat Spatial Audio"
                        android:textColor="#00E5FF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 1-Tap Wallpaper Theme Switcher (Cyber Galaxy / Royal Gold Palace / Velvet Rose / Midnight Neon) -->
                <TextView
                    android:id="@+id/btnWallpaperTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_walla_pill_dark"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:text="🎨 Cyber Galaxy"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Lucky Spin Wheel Button -->
                <Button
                    android:id="@+id/btnLuckySpin"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:backgroundTint="#FF2A7A"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="9dp"
                    android:text="🎰 Lucky Wheel"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Top 3 Gifters Ranking Leaderboard Strip -->
            <LinearLayout
                android:id="@+id/llTopGiftersStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_walla_pill_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆 TOP GIFTERS:"
                    android:textColor="#F1C40F"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTopGiftersLeaderboard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="🥇 Alex 48.5k 🪙  •  🥈 Ryan 31.2k 🪙  •  🥉 Zayn 19.8k 🪙"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. SLIDING GOLDEN MARQUEE ENTRANCE BANNER -->
        <LinearLayout
            android:id="@+id/cardGoldenEntranceBanner"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_below="@id/topHeader"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_walla_gold_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <TextView
                android:id="@+id/tvGoldenEntranceMarquee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="👑 [Lv.50] Julian Vance entered in Interstellar Starship X 🚀  •  ✨ Tap to trigger VIP Entrance!"
                android:textColor="#0A0A14"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. CENTER HOST THRONE (SEAT 0) WITH GOLDEN CROWN BADGE & PULSING SOUNDWAVES -->
        <LinearLayout
            android:id="@+id/hostCenterStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cardGoldenEntranceBanner"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp">

                <!-- Outer Pulsing Royal Gold Neon Halo -->
                <View
                    android:id="@+id/viewHostPulseOuter"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_seat_neon_gold" />

                <!-- Inner Pulsing Hot Pink Halo -->
                <View
                    android:id="@+id/viewHostPulseInner"
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_live_ring_pulse" />

                <!-- Host Circular Avatar -->
                <androidx.cardview.widget.CardView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="#141424"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/ivHostSeatAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Host Throne Avatar"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <!-- Imperial Gold Avatar Frame Overlay -->
                <ImageView
                    android:id="@+id/ivHostDragonFrame"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:contentDescription="Host Imperial Gold Frame"
                    android:scaleType="fitCenter" />

                <!-- Top Golden Crown Badge (Seat 0) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_walla_gold_pill"
                    android:gravity="center"
                    android:paddingHorizontal="7dp"
                    android:text="👑 SEAT 0 • HOST"
                    android:textColor="#0A0A14"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <!-- Bottom Live Mic Indicator -->
                <TextView
                    android:id="@+id/tvHostMicBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_walla_pink_pill"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:text="🎙️ ON AIR"
                    android:textColor="#FFFFFF"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvHostSeatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Julian Vance ✓ • 👑 Lv.50 • Tap Profile"
                android:textColor="#F1C40F"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 5. 7 GUEST CIRCULAR SEATS (SEATS 1–7) WITH AVATAR FRAMES, MUTED MIC BADGES & LOCK ICONS -->
        <LinearLayout
            android:id="@+id/llEightSeatsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/hostCenterStage"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <!-- 6. LIVE SOUNDWAVE / SFX BANNER & ROOM CHAT STREAM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottomVoiceControls"
            android:layout_below="@id/llEightSeatsGrid"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_walla_glass_card"
            android:orientation="vertical"
            android:padding="9dp">

            <TextView
                android:id="@+id/tvSfxLiveTicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎵 Spatial Audio Club: Tap any guest seat for Host Management or Mini Profile!"
                android:textColor="#00E5FF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="3dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/tvVoiceRoomLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="👑 [Lv.50] Julian Vance entered in Interstellar Starship X 🚀\n💖 Alex (Seat 1): Dropping progressive house beats tonight 🔥\n🎁 Ryan (Seat 2) sent Supercar x1 to All Mics!\n🎰 Kabir (Seat 3) won +5,000 Coins (50x) on Lucky Wheel!"
                    android:textColor="#E2E2F5"
                    android:textSize="10.5sp" />
            </ScrollView>
        </LinearLayout>

        <!-- 7. BOTTOM ACTION BAR: Mic Toggle, SFX Soundboard, Lucky Spin Wheel, Gift Drawer -->
        <LinearLayout
            android:id="@+id/bottomVoiceControls"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_walla_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <Button
                android:id="@+id/ivMicToggle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:backgroundTint="#00E676"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="🎙️ Mic ON"
                android:textAllCaps="false"
                android:textColor="#0A0A14"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ivSoundboard"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1.15"
                android:backgroundTint="#00E5FF"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="🔊 SFX Board"
                android:textAllCaps="false"
                android:textColor="#0A0A14"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBottomWheel"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1.1"
                android:backgroundTint="#FF2A7A"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="🎰 Lucky Wheel"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ivGift"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:backgroundTint="#F1C40F"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="🎁 Gift All"
                android:textAllCaps="false"
                android:textColor="#0A0A14"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </RelativeLayout>
</FrameLayout>
