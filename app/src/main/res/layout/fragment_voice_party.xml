<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A14">

    <!-- 1. LUXURY ROOM WALLPAPER BACKGROUND (Cyber Galaxy / Velvet Rose) -->
    <ImageView
        android:id="@+id/ivRoomWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <!-- 2. TOP ROOM HEADER: Room Title, Online Count, Wallpaper Theme Toggle & Lucky Wheel Pill -->
        <LinearLayout
            android:id="@+id/topHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_walla_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRoomTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑 Cyber Galaxy Velvet Lounge"
                    android:textColor="#F1C40F"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRoomSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="ID: 99012 • 🟢 186 Online • Dolby Spatial Audio"
                    android:textColor="#00E5FF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Toggle Cyber Galaxy / Velvet Rose Wallpaper -->
            <TextView
                android:id="@+id/btnWallpaperTheme"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_walla_pill_dark"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="🌌 Galaxy"
                android:textColor="#00E5FF"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <!-- Lucky Spin Wheel Button -->
            <Button
                android:id="@+id/btnLuckySpin"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:backgroundTint="#FF2A7A"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:text="🎡 Lucky Spin"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. HOST CENTER SEAT WITH GOLDEN CROWN BADGE -->
        <LinearLayout
            android:id="@+id/hostCenterStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/topHeader"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp">

                <!-- Outer Pulsing Royal Gold Neon Halo -->
                <View
                    android:id="@+id/viewHostPulseOuter"
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_seat_neon_gold" />

                <!-- Inner Pulsing Hot Pink Halo -->
                <View
                    android:id="@+id/viewHostPulseInner"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_live_ring_pulse" />

                <!-- Host Circular Avatar -->
                <androidx.cardview.widget.CardView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="#141424"
                    app:cardCornerRadius="34dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/ivHostSeatAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <!-- Top Golden Crown Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_walla_gold_pill"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="👑 HOST"
                    android:textColor="#0A0A14"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <!-- Bottom Live Mic Indicator -->
                <TextView
                    android:id="@+id/tvHostMicBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@drawable/bg_walla_pink_pill"
                    android:gravity="center"
                    android:paddingHorizontal="7dp"
                    android:text="🎙️ ON AIR"
                    android:textColor="#FFFFFF"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvHostSeatName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Julian Vance ✓ • 💎 48.2k"
                android:textColor="#F1C40F"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. 8 CIRCULAR MIC SEATS WITH PULSING ANIMATED NEON RINGS WHEN SPEAKING -->
        <LinearLayout
            android:id="@+id/llEightSeatsGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/hostCenterStage"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- 5. LIVE SOUNDWAVE / SFX BANNER & ROOM CHAT STREAM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottomVoiceControls"
            android:layout_below="@id/llEightSeatsGrid"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_walla_glass_card"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvSfxLiveTicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎵 Live Audio Equalizer: Alex, Ryan &amp; Kabir are speaking on Mic..."
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVoiceRoomLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="👑 Julian: Welcome to the Midnight Party Room! Spin the Lucky Wheel 🎡\n💖 Alex (Seat 1): Dropping progressive house beats tonight 🔥\n🎁 Ryan (Seat 2) sent Golden Microphone x1 to Julian!"
                android:textColor="#E2E2F5"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 6. BOTTOM ACTION BAR: Mic Toggle, SFX Soundboard (Applause, DJ Horn), Lucky Spin Wheel, Gift -->
        <LinearLayout
            android:id="@+id/bottomVoiceControls"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_walla_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/ivMicToggle"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#00E676"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="🎙️ Mic ON"
                android:textAllCaps="false"
                android:textColor="#0A0A14"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ivSoundboard"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.15"
                android:backgroundTint="#00E5FF"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="🔊 SFX Board"
                android:textAllCaps="false"
                android:textColor="#0A0A14"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnBottomWheel"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#FF2A7A"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="🎡 Wheel"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ivGift"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:backgroundTint="#F1C40F"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                android:text="🎁 Gift"
                android:textAllCaps="false"
                android:textColor="#0A0A14"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </RelativeLayout>
</FrameLayout>
