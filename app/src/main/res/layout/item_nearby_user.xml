<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="172dp"
    android:layout_margin="4dp"
    app:cardBackgroundColor="#000000"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Edge-to-Edge Full-Bleed Portrait Filling 100% of Card Height -->
        <ImageView
            android:id="@+id/ivUserPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <!-- Smooth Black Gradient Shadow at Bottom Only for Clean Readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_nearby_bottom_scrim" />

        <!-- Top-Left: Tiny Translucent Pill for Distance ("0.3 km") -->
        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="wrap_content"
            android:layout_height="19dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="8dp"
            android:background="@drawable/bg_walla_pill_dark"
            android:gravity="center"
            android:paddingHorizontal="7dp"
            android:text="0.3 km"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <!-- Top-Right: Glowing Green Online Status Dot -->
        <View
            android:id="@+id/viewOnlineIndicator"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="10dp"
            android:background="@drawable/bg_online_dot_glow" />

        <!-- Bottom Text Overlay: Clean White Bold Name ("Alex, 25") + Subtle Role Label (No Clunky Colored Box) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:paddingHorizontal="9dp"
            android:paddingBottom="9dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNameAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Alex, 25"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVerifiedBadge"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_verified_tick"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#000000"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Subtle Muted Role Caption (Preserves ID without rainbow rectangle box) -->
            <TextView
                android:id="@+id/tvRoleTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:text="Top"
                android:textColor="#8E8E93"
                android:textSize="10sp" />
        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>
