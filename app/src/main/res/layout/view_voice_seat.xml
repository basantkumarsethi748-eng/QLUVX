<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/seat_avatar_container"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Outer active speaker halo frame -->
        <View
            android:id="@+id/seat_active_speaker_frame"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_gravity="center"
            android:alpha="0.0"
            android:background="@drawable/bg_active_speaker_frame" />

        <!-- Circular progress drawable layer for the Agora active speaker volume indicator (0..255) -->
        <ProgressBar
            android:id="@+id/seat_volume_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:indeterminate="false"
            android:max="255"
            android:progress="0"
            android:progressDrawable="@drawable/bg_seat_volume_progress" />

        <!-- Round user avatar ImageView -->
        <ImageView
            android:id="@+id/seat_avatar_image"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_avatar_circle"
            android:contentDescription="@string/app_name"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_seat_avatar_empty" />

        <!-- Corner microphone status indicator -->
        <TextView
            android:id="@+id/seat_mic_badge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_mic_badge_on"
            android:gravity="center"
            android:text="🎙"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/seat_name_text"
        android:layout_width="74dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="Seat 1"
        android:textColor="#F8FAFC"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/seat_status_text"
        android:layout_width="74dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="Empty"
        android:textColor="#94A3B8"
        android:textSize="10sp" />

</LinearLayout>
