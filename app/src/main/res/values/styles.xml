<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 2026 World-Class Luxury Minimalist Theme (Walla / Tinder Gold / iOS Dark) -->
    <style name="Theme.QLUVX" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/walla_pink_neon</item>
        <item name="colorPrimaryVariant">@color/walla_surface_obsidian</item>
        <item name="colorSecondary">@color/walla_gold_royal</item>
        <item name="android:windowBackground">@color/walla_bg_velvet</item>
        <item name="android:statusBarColor">#09090E</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:textColorPrimary">@color/qluvx_text_primary</item>
        <item name="android:textColorSecondary">@color/qluvx_text_secondary</item>
    </style>

    <style name="QluvxSectionTitle">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/qluvx_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="QluvxBodyText">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/qluvx_text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
